POSTGRES_DB=wtf_livepulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
TZ=Asia/Kolkata
SESSION_SECRET=replace-with-strong-session-secret
JWT_SECRET=replace-with-a-strong-jwt-secret
JWT_ISSUER=wtf-livepulse
JWT_AUDIENCE=wtf-livepulse-users
JWT_EXPIRES_IN=12h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=loopback
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
ANOMALY_CHECK_INTERVAL_MS=30000
SIMULATOR_TICK_INTERVAL_MS=2000
MATERIALIZED_VIEW_REFRESH_INTERVAL_MS=900000
NEXT_PUBLIC_STRICT_API=true
